PORT=5050

# PostgreSQL
DATABASE_URL=postgresql://USER@127.0.0.1:5432/email_agent

APP_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth (password + invite)
SUPERADMIN_EMAIL=satheesh@xinfin.org
SUPERADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-string
INVITE_TTL_DAYS=7

# Postmark (Sibos / outbound — Activity-verified)
MAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_BROADCAST_STREAM=broadcast
POSTMARK_BULK_CHUNK=500
BROADCAST_THRESHOLD=2
MAX_RECIPIENTS_PER_SEND=10000
# Verified Postmark sender (Sibos From)
SMTP_FROM=support@xdcforpayments.org
OTP_EMAIL_FROM=support@xdcforpayments.org

# SendGrid SMTP (Contour) — used by new events via mail_providers
# For API-key auth, SMTP_USER must be "apikey" and SENDGRID_SMTP_PASS is the SG. key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SENDGRID_FROM=events@contour.network
SENDGRID_SMTP_PASS=your-sendgrid-api-key
