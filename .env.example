PORT=5050

# PostgreSQL
DATABASE_URL=postgresql://USER@127.0.0.1:5432/email_agent

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=your@email.com
OTP_EMAIL_FROM=your@email.com

APP_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth (password + invite)
SUPERADMIN_EMAIL=satheesh@xinfin.org
SUPERADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-string
INVITE_TTL_DAYS=7

# Postmark (HTTPS — use this on Railway)
MAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_MESSAGE_STREAM=outbound
# SMTP_FROM must be a verified Postmark sender signature
