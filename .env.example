PORT=5050

# PostgreSQL
DATABASE_URL=postgresql://USER@127.0.0.1:5432/email_agent

APP_URL=http://localhost:5050
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth (password + invite)
SUPERADMIN_EMAIL=satheesh@xinfin.org
SUPERADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-to-a-long-random-string
INVITE_TTL_DAYS=7

# Postmark (Sibos / outbound — Activity-verified)
MAIL_PROVIDER=postmark
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_MESSAGE_STREAM=outbound
# Verified Postmark sender signature (From address)
SMTP_FROM=support@xdcforpayments.org
OTP_EMAIL_FROM=support@xdcforpayments.org

# SendGrid SMTP (Contour) — used by non-Sibos events via mail_providers
# Username is often "apikey"; password is the SendGrid API key
SENDGRID_SMTP_PASS=your-sendgrid-api-key-or-password
